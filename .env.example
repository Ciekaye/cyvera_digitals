# ---------------------------------------------------------------------------
# Cyvera Digitals — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Discovery-call booking (Google Calendar, OAuth 2.0) -------------------
# OAuth 2.0 client (type: Web application) from Google Cloud Console →
# APIs & Services → Credentials. Calendar API must be enabled on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long-lived refresh token for the Workspace account that owns the calendar,
# granted with scope https://www.googleapis.com/auth/calendar (generate once
# via the OAuth consent flow / OAuth Playground). The app exchanges it for a
# short-lived access token at runtime.
GOOGLE_REFRESH_TOKEN=
# Calendar to read/write. "primary" = that account's main calendar.
GOOGLE_CALENDAR_ID=primary
# Studio timezone. Working hours in src/lib/booking/config.ts are read in this zone.
BOOKING_OWNER_TIMEZONE=Asia/Manila

# --- Contact form (Resend) -------------------------------------------------
RESEND_API_KEY=
# Where contact-form inquiries land. Optional — defaults to
# info@cyveradigitals.com. Set this only to route elsewhere (e.g. testing).
ADMIN_EMAIL=
# The "from" address. Required, and must be a sender verified in Resend.
ADMIN_SENDER_EMAIL=

# --- Misc ------------------------------------------------------------------
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
